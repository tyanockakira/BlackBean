VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key

# Official local Turnstile test keys. Use real keys in hosted environments.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Server only. Copy the local service_role key from Supabase; never prefix this with VITE_.
SUPABASE_SERVER_KEY=your-local-service-role-key
# Required in hosted environments, e.g. blackbean.example,www.blackbean.example
TURNSTILE_HOSTNAMES=
